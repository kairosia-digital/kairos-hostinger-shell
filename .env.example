# Opcional en despliegue: Ruta A (cero clics) si se pega aquí; Ruta B (Pantalla Guardián en :8069) si se deja vacío.
PROVISION_TOKEN=

# Orquestador Central Kairós IA
ORCHESTRATOR_URL=https://kaito.ddns.net

# Dominio asignado por Hostinger/cliente (opcional; si se omite se autodetecta en el Guardián o Hostinger Traefik)
INSTANCE_FQDN=

# Contraseña inicial opcional para el administrador Odoo (si se omite se genera por CSPRNG)
ODOO_INITIAL_ADMIN_PASSWORD=

# Credenciales internas PostgreSQL dentro del VPS (el acceso externo al puerto 5432 no está expuesto)
POSTGRES_USER=odoo
POSTGRES_PASSWORD=kairos_pg_internal_change_me

# Puerto UDP entrante para túnel WireGuard punto a punto hacia el servidor a3ERP local
WG_LISTEN_PORT=51820

# Verificación activa estricta de Gemini API e IMAP durante el onboarding (true/false)
KAIROS_STRICT_PREFLIGHT=true
